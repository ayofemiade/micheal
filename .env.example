# Environment Configuration Template
# Copy this file to .env.local for local development overrides.
# Do not commit real credentials or production secrets to version control.

# The real Listening Hub booking calendar. Both "Book a Listening Session"
# buttons open this one address. Leave unset until the calendar exists.
# NEXT_PUBLIC_BOOKING_URL=

# The Contact form sends through Resend (https://resend.com). Server only: never
# prefix these with NEXT_PUBLIC. Without both of the first two, the form shows a
# failure and sends nothing. Until a domain is verified, leave CONTACT_FROM_EMAIL
# unset: Resend's test sender then delivers only to the Resend account's own email.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=Segun Michael website <inquiries@your-domain.com>

# Public application environment ("development" | "preview" | "production")
# NEXT_PUBLIC_APP_ENV=development

